<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><title>ANNOVA — Playable Demo</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root{--bg:#0a0714;--p:rgba(15,10,30,.55);--a:#ff5da2;--b:#7a5cff;--t:#f2eaff}
html,body{margin:0;height:100%;background:var(--bg);overflow:hidden;font-family:-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--t)}
#app{position:fixed;inset:0}canvas{display:block}
#loading{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 40%,#1b1030,#06040d 75%);transition:opacity .6s}
#loading h1{font-size:clamp(2.2rem,6vw,4rem);letter-spacing:.35em;margin:0 0 .3em;background:linear-gradient(90deg,var(--a),var(--b));-webkit-background-clip:text;background-clip:text;color:transparent}
#loading p{margin:0 0 1.4em;opacity:.75;font-size:.9rem;letter-spacing:.15em;text-transform:uppercase}
.bar{width:min(360px,70vw);height:6px;border-radius:6px;background:rgba(255,255,255,.08);overflow:hidden}.bar>div{height:100%;width:0;background:linear-gradient(90deg,var(--b),var(--a));transition:width .25s}
#err{margin-top:1em;color:#ff8a8a;font-size:.85rem;display:none;max-width:80vw;text-align:center}
#retry{margin-top:1em;padding:.6em 1.4em;border-radius:999px;border:1px solid #fff4;background:#fff1;color:var(--t);cursor:pointer;display:none}
#fade{position:fixed;inset:0;background:#05030a;opacity:0;pointer-events:none;transition:opacity .38s;z-index:40}
#hud{position:fixed;inset:0;pointer-events:none;z-index:20;opacity:0;transition:opacity .8s}#hud.show{opacity:1}
.pn{background:var(--p);backdrop-filter:blur(6px);border:1px solid #ffffff14;border-radius:12px}
#status{position:absolute;top:18px;left:18px;padding:8px 14px;font-size:.75rem;letter-spacing:.08em}#status b{color:var(--a)}
#prompt{position:absolute;bottom:14%;left:50%;transform:translate(-50%,10px);padding:10px 18px;font-size:.88rem;opacity:0;transition:.25s}
#prompt.show{opacity:1;transform:translate(-50%,0)}
kbd{background:#ffffff1f;padding:2px 7px;border-radius:6px;margin-right:6px;border:1px solid #fff3;font-weight:600}
#title{position:absolute;top:8%;left:50%;transform:translate(-50%,-8px);font-size:1.1rem;letter-spacing:.5em;text-transform:uppercase;opacity:0;transition:.8s;text-shadow:0 0 20px #ff5da299;white-space:nowrap}#title.show{opacity:.92;transform:translate(-50%,0)}
#controls{position:absolute;bottom:18px;right:18px;padding:10px 14px;font-size:.68rem;line-height:1.6;text-align:right}#controls b{color:var(--b)}
#hint{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#0005;pointer-events:auto;cursor:pointer;letter-spacing:.1em}
#hint span{padding:14px 28px;border-radius:999px}
#dbg{position:absolute;top:18px;right:18px;padding:8px 12px;background:#000a;font-size:.65rem;line-height:1.5;white-space:pre;display:none;border-radius:8px}
</style></head><body>
<div id="app"></div><div id="fade"></div>
<div id="loading"><h1>ANNOVA</h1><p id="ltxt">Loading world…</p><div class="bar"><div id="lbar"></div></div><div id="err"></div><button id="retry">Retry</button></div>
<div id="hud"><div id="title"></div><div id="status" class="pn">ANNOVA <b>◆</b> <span id="ph">Day</span></div><div id="prompt" class="pn"></div>
<div id="controls" class="pn"><b>WASD</b> move · <b>SHIFT</b> run · <b>SPACE</b> jump · <b>E</b> interact/nod · <b>H</b> wave<br><b>scroll</b> zoom · <b>T</b> preview time of day · <b>mouse</b> look</div><div id="dbg"></div>
<div id="hint"><span class="pn">Click to enter ANNOVA</span></div></div>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
<script>
(function(){"use strict";
const showErr=m=>{const e=document.getElementById('err'),r=document.getElementById('retry');if(e){e.style.display='block';e.textContent=m;r.style.display='inline-block'}};
addEventListener('error',ev=>showErr('Error: '+(ev.message||'unknown')));addEventListener('unhandledrejection',ev=>showErr('Error: '+(ev.reason&&ev.reason.message||ev.reason)));
setTimeout(()=>{const l=document.getElementById('loading');if(l&&l.style.display!=='none'&&l.style.opacity!=='0')showErr('Loading is taking too long. Check your connection and retry.')},25000);
/* ---- Central asset + config registry ---- */
const ASSETS={"character": "data:application/octet-stream;base64,", "floor": "data:application/octet-stream;base64,", "tree": "data:application/octet-stream;base64,", "lamp": "data:application/octet-stream;base64,", "studio": "data:application/octet-stream;base64,", "anim_idle": "data:application/octet-stream;base64,", "anim_walk": "data:application/octet-stream;base64,", "anim_run": "data:application/octet-stream;base64,", "anim_jump": "data:application/octet-stream;base64,", "anim_wave": "data:application/octet-stream;base64,", "anim_headnod": "data:application/octet-stream;base64,"};
const HF={"n": 146, "cell": 0.5, "origin": -36, "data": ""};
const BUILDINGS=[ // each building maps to an interior id from ASSETS (all use the studio room for now)
 {id:'gallery',name:'Gallery',interior:'studio'},{id:'workshop',name:'Workshop',interior:'studio'},
 {id:'studio',name:'Your Studio',interior:'studio'},{id:'academy',name:'Academy',interior:'studio'},{id:'market',name:'Market',interior:'studio'}];
const C={walk:2.4,run:5.2,accel:14,decel:12,rot:11,jump:5.6,g:-16,step:.36,r:.3,h:1.7,mouse:.0026,fov:55,runFov:7,modelYaw:0,R:33.3};
const $=id=>document.getElementById(id),clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),sleep=ms=>new Promise(r=>setTimeout(r,ms));
const q=new URLSearchParams(location.search),DEBUG=q.get('debug')==='true';

/* ---- Renderer ---- */
const renderer=new THREE.WebGLRenderer({antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);
renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputEncoding=THREE.sRGBEncoding;$('app').appendChild(renderer.domElement);
const scene=new THREE.Scene();scene.background=new THREE.Color(0x0a0714);scene.fog=new THREE.FogExp2(0x0d0a1c,.02);
const camera=new THREE.PerspectiveCamera(C.fov,innerWidth/innerHeight,.1,600);
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
const hemi=new THREE.HemisphereLight(0x8fb8ff,0x201830,.5);scene.add(hemi);
const sun=new THREE.DirectionalLight(0xffe3b0,1);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);
Object.assign(sun.shadow.camera,{left:-30,right:30,top:30,bottom:-30,far:120});sun.shadow.bias=-.0005;scene.add(sun,sun.target);
const moon=new THREE.DirectionalLight(0x8fa8ff,0);moon.position.set(-20,40,-10);scene.add(moon);
const starGeo=new THREE.BufferGeometry(),sp=[];for(let i=0;i<700;i++){const u=Math.random()*6.283,v=Math.random()*1.4+.1,r=400;sp.push(Math.cos(u)*Math.cos(v)*r,Math.sin(v)*r,Math.sin(u)*Math.cos(v)*r)}
starGeo.setAttribute('position',new THREE.Float32BufferAttribute(sp,3));
const stars=new THREE.Points(starGeo,new THREE.PointsMaterial({color:0xffffff,size:1.8,sizeAttenuation:false,transparent:true,fog:false,depthWrite:false}));scene.add(stars);

/* ---- Input (centralized, semantic) ---- */
const In={keys:{},once:new Set(),dx:0,dy:0,lock:false,drag:false};
const K=c=>!!In.keys[c];
addEventListener('keydown',e=>{if(e.repeat)return;In.keys[e.code]=1;In.once.add(e.code);if(e.code==='Space')e.preventDefault()});
addEventListener('keyup',e=>{In.keys[e.code]=0});
addEventListener('blur',()=>{In.keys={};In.once.clear();In.drag=false});document.addEventListener('visibilitychange',()=>{if(document.hidden){In.keys={};In.drag=false}});
addEventListener('wheel',e=>{e.preventDefault();Cam.zoom=clamp(Cam.zoom*(1+Math.sign(e.deltaY)*.08),.45,1.8)},{passive:false});
const cv=renderer.domElement;cv.addEventListener('mousedown',()=>In.drag=true);addEventListener('mouseup',()=>In.drag=false);
document.addEventListener('pointerlockchange',()=>In.lock=document.pointerLockElement===cv);
addEventListener('mousemove',e=>{if(In.lock||In.drag){In.dx+=e.movementX||0;In.dy+=e.movementY||0}});
$('hint').addEventListener('click',()=>{$('hint').style.display='none';try{cv.requestPointerLock()}catch(e){}});
cv.addEventListener('click',()=>{if(!In.lock)try{cv.requestPointerLock()}catch(e){}});

/* ---- Worlds + capsule collision (own implementation: slide, step-up, ground snap) ---- */
const mkWorld=n=>({name:n,group:new THREE.Group(),cols:[],walk:[],camMeshes:[],ints:[],minY:-15,bounds:null,cam:{dist:6.2,ceil:99}});
function addCol(w,cx,cz,hw,hd,y0,y1,rot=0){w.cols.push({cx,cz,hw,hd,y0,y1,c:Math.cos(rot),s:Math.sin(rot)})}
function blocked(w,x,z,fy,grounded){
 for(const c of w.cols){if(c.y1<=fy+C.step||c.y0>=fy+C.h)continue;
  const dx=x-c.cx,dz=z-c.cz,lx=dx*c.c-dz*c.s,lz=dx*c.s+dz*c.c,ex=lx-clamp(lx,-c.hw,c.hw),ez=lz-clamp(lz,-c.hd,c.hd);
  if(ex*ex+ez*ez<C.r*C.r)return true}
 return grounded&&groundAt(w,x,z,fy)===-Infinity}
function hfH(w,x,z){const h=w.hf,fx=(x-h.o)/h.c-.5,fz=(z-h.o)/h.c-.5,i=Math.floor(fx),k=Math.floor(fz),tx=fx-i,tz=fz-k;
 if(i<0||k<0||i+1>=h.n||k+1>=h.n)return -Infinity;const g=(a,b)=>h.d[(i+a)*h.n+k+b],v=[g(0,0),g(0,1),g(1,0),g(1,1)];if(v.some(d=>d===-32768))return -Infinity;
 if(Math.max(...v)-Math.min(...v)>40)return v[(tx>.5?2:0)+(tz>.5?1:0)]/100;return((v[0]*(1-tz)+v[1]*tz)*(1-tx)+(v[2]*(1-tz)+v[3]*tz)*tx)/100}
function groundAt(w,x,z,fy){if(w.hf){const h=hfH(w,x,z);return h<=fy+C.step+.001?h:-Infinity}let g=-Infinity;for(const f of w.walk)if(x>=f.x0&&x<=f.x1&&z>=f.z0&&z<=f.z1&&f.y<=fy+C.step+.001&&f.y>g)g=f.y;return g}
function clampBounds(w,p){const b=w.bounds;if(b.R){const d=Math.hypot(p.x,p.z);if(d>b.R){p.x*=b.R/d;p.z*=b.R/d}}else{p.x=clamp(p.x,b.x0,b.x1);p.z=clamp(p.z,b.z0,b.z1)}}

/* ---- Time of day ---- */
const TOD={ov:q.get('hour')!=null?+q.get('hour'):null,s:null,phase:'Day',n:0,presets:[null,12,18.5,22],pi:0};
const cN=new THREE.Color(0x0b0818),cD=new THREE.Color(0x7fb2ff),cS=new THREE.Color(0xff8e63),cT=new THREE.Color();
const lamps=[],winMat=new THREE.MeshStandardMaterial({color:0x40332a,emissive:0xffb35c,emissiveIntensity:.2});
let treeLight=null,lampGlow=null,treeMat=null;
function updateTime(dt){
 const d=new Date();let h=TOD.ov!=null?TOD.ov:d.getHours()+d.getMinutes()/60;let s;
 if(h>=5&&h<7){TOD.phase='Dawn';s=(h-5)/2}else if(h>=7&&h<17){TOD.phase='Day';s=1}else if(h>=17&&h<20){TOD.phase='Sunset';s=1-(h-17)/3}else{TOD.phase='Night';s=0}
 TOD.s=TOD.s==null?s:TOD.s+(s-TOD.s)*Math.min(1,dt*1.2);s=TOD.s;
 const inCity=cur===city,tw=1-Math.abs(2*s-1);
 if(inCity){cT.copy(cN).lerp(cD,s).lerp(cS,tw*.55);scene.background.copy(cT);scene.fog.color.copy(cT).multiplyScalar(.85);scene.fog.density=.016+(1-s)*.012;
  hemi.intensity=.22+.5*s;const a=((h-6)/12)*Math.PI;sun.position.set(P.pos.x+Math.cos(a)*50,Math.max(8,Math.sin(a)*50),P.pos.z+15);sun.target.position.copy(P.pos);
  sun.intensity=1.25*s;sun.color.setHSL(.09+.03*s,.8,.62+.18*s);moon.intensity=(1-s)*.5;stars.material.opacity=clamp(1-s*1.6,0,1);stars.visible=true}
 else{scene.background.set(0x0b0814);scene.fog.color.set(0x0b0814);scene.fog.density=.01;hemi.intensity=1.1;sun.intensity=0;moon.intensity=0;stars.visible=false}
 TOD.n+=((clamp((.55-s)/.3,0,1))-TOD.n)*Math.min(1,dt*3);const n=TOD.n;
 for(const l of lamps)l.intensity=n*3.4;if(lampGlow)lampGlow.emissiveIntensity=.12+n*2.8;if(treeMat)treeMat.emissiveIntensity=n*.3;
 winMat.emissiveIntensity=.12+n*1.7;if(treeLight)treeLight.intensity=1+n*1.4;$('ph').textContent=TOD.phase+(TOD.ov!=null?' (preview)':'')}

/* ---- City: floor / tree / lamp are your GLBs; buildings are placeholder boxes until their models exist ---- */
const M=(c,o={})=>new THREE.MeshStandardMaterial(Object.assign({color:c,roughness:.9},o));
function box(w,h,d,mat,x,y,z,parent,shadow=true){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);m.castShadow=shadow;m.receiveShadow=true;parent.add(m);return m}
function label(t){const c=document.createElement('canvas');c.width=512;c.height=96;const x=c.getContext('2d');x.font='600 44px sans-serif';x.textAlign='center';x.fillStyle='#fff';x.shadowColor='#ff5da2';x.shadowBlur=14;x.fillText(t.toUpperCase(),256,60);
 const s=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),transparent:true,depthWrite:false,fog:false}));s.scale.set(6,1.1,1);return s}
const PLOTS=[[-15.4,20.1],[-11.7,-22.6],[12.4,23.4],[16.3,-20],[23.8,2.9]]; // grass wedges measured from floor_city.glb
function buildCity(R){
 const w=mkWorld('CENTRAL PLAZA'),g=w.group;w.bounds={R:C.R};w.cam={dist:6.5,ceil:99,R:34.4};w.minY=-15;
 const raw=atob(HF.data),u8=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)u8[i]=raw.charCodeAt(i);w.hf={n:HF.n,c:HF.cell,o:HF.origin,d:new Int16Array(u8.buffer)};
 const gy=(x,z)=>{const h=groundAt(w,x,z,99);return h===-Infinity?0:h};
 R.floor.scene.traverse(o=>{if(o.isMesh){o.receiveShadow=true;[].concat(o.material).forEach(m=>{m.roughness=1;m.metalness=0})}});g.add(R.floor.scene);
 const vd=new THREE.Mesh(new THREE.CircleGeometry(500,32),M(0x07050e));vd.rotation.x=-Math.PI/2;vd.position.y=-5;g.add(vd);
 if(R.tree){const t=R.tree.scene;t.traverse(o=>{if(o.isMesh){o.castShadow=o.receiveShadow=true;treeMat=o.material;treeMat.emissive=new THREE.Color(0x8a2a90);treeMat.emissiveIntensity=0;treeMat.roughness=1;treeMat.metalness=0}});g.add(t);addCol(w,0,0,2.1,2.1,0,7);
  treeLight=new THREE.PointLight(0xff6fd8,1.2,24,2);treeLight.position.set(0,6,0);g.add(treeLight)}
 // buildings (door faces plaza centre)
 const bodyM=M(0x8a7396),roofM=M(0x4a3d66),doorM=M(0x2b2140,{emissive:0xffa050,emissiveIntensity:.15}),awnM=M(0x2a2f66),stepM=M(0x5b4d78);
 BUILDINGS.forEach((b,i)=>{const [px,pz]=PLOTS[i],yaw=Math.atan2(-px,-pz),y0=gy(px,pz);
  const bg=new THREE.Group();bg.position.set(px,y0,pz);bg.rotation.y=yaw;g.add(bg);
  w.camMeshes.push(box(12,8,8,bodyM,0,3,0,bg),box(12.6,.45,8.6,roofM,0,7.2,0,bg));
  box(2,3.2,.1,doorM,0,1.6,4.03,bg);box(3.6,.3,1.5,awnM,0,3.5,4.6,bg);box(3,.25,1.6,stepM,0,.12,4.8,bg);
  [-3.8,3.8].forEach(x=>box(1.6,1.8,.08,winMat,x,3.4,4.03,bg,false));
  const lb=label(b.name);lb.position.set(0,5.7,4.6);bg.add(lb);addCol(w,px,pz,6.1,4.1,y0-1,y0+8.5,yaw);
  const ix=px+Math.sin(yaw)*5.4,iz=pz+Math.cos(yaw)*5.4;
  w.ints.push({x:ix,z:iz,dist:2.6,prompt:'Enter '+b.name,action:()=>enterBuilding(b,ix,iz,yaw)})});
 // lamps: placed on flat road cells near the wanted spots; first 10 get real point lights
 if(R.lamp){const L=R.lamp.scene;L.traverse(o=>{if(o.isMesh){o.castShadow=true;[].concat(o.material).forEach(m=>{m.roughness=.8;m.metalness=0;if(m.name==='glow')lampGlow=m})}});
  const flat=(x,z)=>{let best=null,bs=1e9;for(let dx=-3;dx<=3;dx+=.5)for(let dz=-3;dz<=3;dz+=.5){const px=x+dx,pz=z+dz,h=groundAt(w,px,pz,99);if(h===-Infinity||Math.abs(h)>.25)continue;let mn=h,mx=h,ok=true;
   for(const [a,b] of [[.8,0],[-.8,0],[0,.8],[0,-.8]]){const t=groundAt(w,px+a,pz+b,99);if(t===-Infinity){ok=false;break}mn=Math.min(mn,t);mx=Math.max(mx,t)}if(!ok)continue;const sc=mx-mn+Math.hypot(dx,dz)*.03;if(sc<bs){bs=sc;best=[px,pz,h]}}return best};
  const want=[];for(let k=0;k<8;k++){const a=(22.5+45*k)*Math.PI/180;want.push([Math.sin(a)*15,Math.cos(a)*15])}want.push([-23,4],[-23,-5]);for(let k=0;k<8;k++){const a=(45*k)*Math.PI/180;want.push([Math.sin(a)*27,Math.cos(a)*27])}
  const placed=[];want.forEach(([x,z],i)=>{const f=flat(x,z);if(!f||placed.some(p=>Math.hypot(p[0]-f[0],p[1]-f[1])<4))return;placed.push(f);
   const l=L.clone();l.position.set(f[0],f[2],f[1]);g.add(l);addCol(w,f[0],f[1],.25,.25,f[2],f[2]+3.6);
   if(lamps.length<10){const pl=new THREE.PointLight(0xffb066,0,13,2);pl.position.set(f[0],f[2]+2.9,f[1]);g.add(pl);lamps.push(pl)}})}
 w.spawn={x:-20,z:-.7,yaw:Math.PI/2};return w}

/* ---- Interiors (lazy loaded + cached) ---- */
const loader=new THREE.GLTFLoader(),interiors={};
const u8b64=a=>{let s='';for(let i=0;i<a.length;i+=8192)s+=String.fromCharCode.apply(null,a.subarray(i,i+8192));return btoa(s)};
// Rewrites embedded images to data: URIs (page CSP blocks blob/fetch decoding); strip=true drops textures entirely
function prepGLB(buf,strip){const dv=new DataView(buf),u=new Uint8Array(buf),jl=dv.getUint32(12,true),j=JSON.parse(new TextDecoder().decode(u.subarray(20,20+jl)));
 const bo=20+jl+8,bl=dv.getUint32(20+jl,true),bin=u.subarray(bo,bo+bl);
 if(strip){delete j.images;delete j.textures;delete j.samplers;(j.materials||[]).forEach(m=>{const p=m.pbrMetallicRoughness;if(p)delete p.baseColorTexture;delete m.normalTexture;delete m.emissiveTexture})}
 else(j.images||[]).forEach(im=>{if(im.bufferView!=null){const v=j.bufferViews[im.bufferView];im.uri='data:'+(im.mimeType||'image/png')+';base64,'+u8b64(bin.subarray(v.byteOffset||0,(v.byteOffset||0)+v.byteLength));delete im.bufferView;delete im.mimeType}});
 let js=new TextEncoder().encode(JSON.stringify(j));const pad=(4-js.length%4)%4;const jp=new Uint8Array(js.length+pad).fill(32);jp.set(js);
 const out=new Uint8Array(12+8+jp.length+8+bl),o=new DataView(out.buffer);o.setUint32(0,0x46546C67,true);o.setUint32(4,2,true);o.setUint32(8,out.length,true);
 o.setUint32(12,jp.length,true);o.setUint32(16,0x4E4F534A,true);out.set(jp,20);const bp=20+jp.length;o.setUint32(bp,bl,true);o.setUint32(bp+4,0x004E4942,true);out.set(bin,bp+8);return out.buffer}
const rawParse=buf=>new Promise((res,rej)=>{const cib=window.createImageBitmap;window.createImageBitmap=undefined;const t=setTimeout(()=>{window.createImageBitmap=cib;rej(new Error('model parse timed out'))},15000);
 const done=f=>x=>{clearTimeout(t);window.createImageBitmap=cib;f(x)};try{loader.parse(buf,'',done(res),done(rej))}catch(e){done(rej)(e)}});
const bufOf=async u=>{if(u.startsWith('data:')){const b=atob(u.slice(u.indexOf(',')+1)),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);return a.buffer}const r=await fetch(u);if(!r.ok)throw new Error('Could not load '+u);return r.arrayBuffer()};
const parseGLB=async uri=>{const buf=await bufOf(uri);try{return await rawParse(prepGLB(buf,false))}catch(e){console.warn('textured parse failed, retrying without textures',e);return await rawParse(prepGLB(buf,true))}};
const ROOMHF={"n": 80, "cell": 0.1, "origin": -4.0, "data": "", "spawn": [0.4500000000000002, 0.35000000000000053, 1.9677466453473307], "exit": [2.3500000000000005, 0.35000000000000053], "box": [-1.95, 2.8500000000000005, -1.6499999999999997, 2.05], "wallH": 3.5};
async function getInterior(id){
 if(interiors[id])return interiors[id];
 const gltf=await parseGLB(ASSETS[id]),w=mkWorld(id),root=gltf.scene,hf=ROOMHF;
 root.traverse(o=>{if(o.isMesh)[].concat(o.material).forEach(m=>{m.side=THREE.DoubleSide;m.roughness=.9;m.metalness=0})});w.group.add(root);
 const raw=atob(hf.data),u8=new Uint8Array(raw.length);for(let k=0;k<raw.length;k++)u8[k]=raw.charCodeAt(k);w.hf={n:hf.n,c:hf.cell,o:hf.origin,d:new Int16Array(u8.buffer)};
 const [x0,x1,z0,z1]=hf.box;w.bounds={x0,x1,z0,z1};w.minY=-10;w.cam={dist:3.2,ceil:hf.wallH-.3,box:{x0,x1,z0,z1}};
 [[0,2.9,0,0xffc680,1.4,16],[-1.6,2.4,-2.4,0xffb070,.8,10],[1.8,2.4,2.4,0xffd8a0,.8,10]].forEach(([x,y,z,c,k,d])=>{const l=new THREE.PointLight(c,k,d,2);l.position.set(x,y,z);w.group.add(l)});
 const ring=new THREE.Mesh(new THREE.RingGeometry(.45,.6,40),new THREE.MeshBasicMaterial({color:0xff5da2,side:THREE.DoubleSide,transparent:true,opacity:.85}));ring.rotation.x=-Math.PI/2;ring.position.set(hf.exit[0],.06,hf.exit[1]);w.group.add(ring);
 const lb=label('Exit');lb.position.set(hf.exit[0],1.7,hf.exit[1]);lb.scale.set(2.4,.45,1);w.group.add(lb);
 const sy=groundAt(w,hf.spawn[0],hf.spawn[1],99);w.spawn={x:hf.spawn[0],y:sy>-1e8?sy:0,z:hf.spawn[1],yaw:hf.spawn[2]};
 w.ints.push({x:hf.exit[0],z:hf.exit[1],dist:1.5,prompt:'Exit',action:exitBuilding});
 return interiors[id]=w}

/* ---- Player + animation state machine (clips crossfade; one clip per state) ---- */
const P={root:new THREE.Group(),vis:null,mixer:null,acts:{},cur:null,curKey:'',pos:new THREE.Vector3(),vy:0,vx:0,vz:0,grounded:true,face:0,state:'IDLE',landT:0,waveT:0,nodT:0,safe:new THREE.Vector3()};
function place(x,y,z,yaw){P.pos.set(x,y,z);P.safe.copy(P.pos);P.vx=P.vz=P.vy=0;P.grounded=true;P.face=yaw;Cam.yaw=yaw+Math.PI;Cam.snap=true}
function fadeTo(key,fade,once,speed){const a=P.acts[key];if(!a)return;const prev=P.cur;a.reset();a.setLoop(once?THREE.LoopOnce:THREE.LoopRepeat,once?1:Infinity);a.clampWhenFinished=once;a.timeScale=speed;a.enabled=true;a.setEffectiveWeight(1);a.play();
 if(prev&&prev!==a)prev.crossFadeTo(a,fade,false);else a.fadeIn(fade);P.cur=a;P.curKey=key}
function updatePlayer(dt){
 const w=cur,lock=busy;let ix=lock?0:(K('KeyD')?1:0)-(K('KeyA')?1:0),iz=lock?0:(K('KeyW')?1:0)-(K('KeyS')?1:0);
 const moving=!!(ix||iz),sprint=moving&&(K('ShiftLeft')||K('ShiftRight'));
 const fx=-Math.sin(Cam.yaw),fz=-Math.cos(Cam.yaw);let wx=fx*iz-fz*ix,wz=fz*iz+fx*ix;const l=Math.hypot(wx,wz)||1;wx/=l;wz/=l; // normalized: diagonals aren't faster
 const spd=moving?(sprint?C.run:C.walk):0,k=Math.min(1,dt*(moving?C.accel:C.decel));
 P.vx+=(wx*spd-P.vx)*k;P.vz+=(wz*spd-P.vz)*k;
 if(!lock&&P.grounded&&In.once.has('Space')){P.vy=C.jump;P.grounded=false;P.waveT=P.nodT=0}
 const nx=P.pos.x+P.vx*dt;if(!blocked(w,nx,P.pos.z,P.pos.y,P.grounded))P.pos.x=nx;else P.vx=0;
 const nz=P.pos.z+P.vz*dt;if(!blocked(w,P.pos.x,nz,P.pos.y,P.grounded))P.pos.z=nz;else P.vz=0;
 clampBounds(w,P.pos);
 const g=groundAt(w,P.pos.x,P.pos.z,P.pos.y);
 if(P.grounded){if(g>-Infinity&&P.pos.y-g<=C.step+.01){P.pos.y+=(g-P.pos.y)*Math.min(1,dt*25);if(Math.abs(g-P.pos.y)<.003)P.pos.y=g}else{P.grounded=false;P.vy=0}}
 else{P.vy+=C.g*dt;P.pos.y+=P.vy*dt;if(P.vy<=0&&g>-Infinity&&P.pos.y<=g){P.pos.y=g;P.grounded=true;P.landT=P.vy<-4?.28:.14;Cam.dip=P.vy<-4?.14:.07;P.vy=0}}
 if(P.grounded&&g>-Infinity&&!blocked(w,P.pos.x,P.pos.z,P.pos.y,false))P.safe.copy(P.pos);
 if(P.pos.y<w.minY){P.pos.copy(P.safe);P.vy=P.vx=P.vz=0;P.grounded=true}
 if(moving){P.waveT=P.nodT=0}
 if(!lock&&P.grounded&&!moving&&In.once.has('KeyH')&&P.waveT<=0&&P.acts.wave)P.waveT=P.acts.wave.getClip().duration/1.6;
 let st;if(!P.grounded)st=P.vy>0?'JUMP':'FALL';else if(P.landT>0){st='LAND';P.landT-=dt}else if(P.waveT>0){st='WAVE';P.waveT-=dt}else if(P.nodT>0){st='INTERACT';P.nodT-=dt}else st=moving?(sprint?'RUN':'WALK'):'IDLE';
 P.state=st;
 let key,once=false,speed=1,fade=.22;
 if(st==='JUMP'||st==='FALL'){key='jump';once=true;speed=1.7;fade=.12}else if(st==='WAVE'){key='wave';once=true;speed=1.6;fade=.25}else if(st==='INTERACT'){key='headnod';once=true;fade=.2}
 else key=moving?(sprint?'run':'walk'):'idle';
 if(key!==P.curKey)fadeTo(key,fade,once,speed);
 if(P.mixer)P.mixer.update(dt);
 if(moving){let d=Math.atan2(wx,wz)-P.face;d=Math.atan2(Math.sin(d),Math.cos(d));P.face+=d*Math.min(1,dt*C.rot)}
 P.root.position.copy(P.pos);P.root.rotation.y=P.face+C.modelYaw;
 if(P.vis)P.vis.scale.y=P.vis.userData.s*(st==='LAND'?.95:1);
 Cam.sprint=sprint}

/* ---- Camera rig ---- */
const Cam={yaw:0,zoom:1,pitch:.32,dist:6.2,snap:true,dip:0,sprint:false,fov:C.fov,ray:new THREE.Raycaster(),tgt:new THREE.Vector3(),des:new THREE.Vector3(),dir:new THREE.Vector3()};
function updateCam(dt){
 Cam.yaw-=In.dx*C.mouse;Cam.pitch=clamp(Cam.pitch+In.dy*C.mouse,-.1,1.25);In.dx=In.dy=0;Cam.dip*=Math.max(0,1-dt*7);
 const cfg=cur.cam,want=cfg.dist*Cam.zoom*(Cam.sprint?1.1:1);Cam.dist+=(want-Cam.dist)*Math.min(1,dt*4);
 Cam.tgt.set(P.pos.x,P.pos.y+1.4-Cam.dip,P.pos.z);
 const cp=Math.cos(Cam.pitch);Cam.des.set(Math.sin(Cam.yaw)*cp,Math.sin(Cam.pitch),Math.cos(Cam.yaw)*cp).multiplyScalar(Cam.dist).add(Cam.tgt);
 if(cur.camMeshes.length){Cam.dir.copy(Cam.des).sub(Cam.tgt);const len=Cam.dir.length();Cam.dir.normalize();Cam.ray.set(Cam.tgt,Cam.dir);Cam.ray.far=len;
  const h=Cam.ray.intersectObjects(cur.camMeshes,false);if(h.length)Cam.des.copy(Cam.tgt).addScaledVector(Cam.dir,Math.max(.8,h[0].distance-.3))}
 if(cfg.R){const d=Math.hypot(Cam.des.x,Cam.des.z);if(d>cfg.R){Cam.des.x*=cfg.R/d;Cam.des.z*=cfg.R/d}}
 if(cfg.box){Cam.des.x=clamp(Cam.des.x,cfg.box.x0,cfg.box.x1);Cam.des.z=clamp(Cam.des.z,cfg.box.z0,cfg.box.z1)}
 Cam.des.y=clamp(Cam.des.y,P.pos.y+.3,cfg.ceil);
 camera.position.lerp(Cam.des,Cam.snap?1:Math.min(1,dt*10));Cam.snap=false;camera.lookAt(Cam.tgt);
 const hs=Math.hypot(P.vx,P.vz);Cam.fov+=(C.fov+(Cam.sprint&&hs>3?C.runFov:0)-Cam.fov)*Math.min(1,dt*4);camera.fov=Cam.fov;camera.updateProjectionMatrix()}

/* ---- Interaction + world transitions ---- */
let city,cur,busy=false,ret=null;
function checkInt(){
 let best=null,bd=1e9;if(!busy)for(const it of cur.ints){const d=Math.hypot(P.pos.x-it.x,P.pos.z-it.z);if(d<it.dist&&d<bd){best=it;bd=d}}
 const pr=$('prompt');if(best){pr.innerHTML='<kbd>E</kbd>'+best.prompt;pr.classList.add('show');if(In.once.has('KeyE'))best.action()}
 else{pr.classList.remove('show');if(In.once.has('KeyE')&&!busy&&P.grounded&&P.nodT<=0&&P.acts.headnod)P.nodT=P.acts.headnod.getClip().duration}}
function setTitle(t){const e=$('title');e.textContent=t;e.classList.add('show');clearTimeout(setTitle.t);setTitle.t=setTimeout(()=>e.classList.remove('show'),2600)}
async function transition(fn){busy=true;$('fade').style.opacity=1;await sleep(400);try{await fn()}catch(e){console.error(e);setTitle('Could not load that place')}await sleep(120);$('fade').style.opacity=0;await sleep(400);busy=false}
function setWorld(w){scene.remove(cur.group);cur=w;scene.add(w.group)}
function enterBuilding(b,ix,iz,yaw){if(busy)return;transition(async()=>{const w=await getInterior(b.interior);ret={x:ix,z:iz,yaw};setWorld(w);place(w.spawn.x,w.spawn.y,w.spawn.z,w.spawn.yaw);setTitle(b.name)})}
function exitBuilding(){if(busy||!ret)return;transition(async()=>{setWorld(city);place(ret.x,Math.max(groundAt(city,ret.x,ret.z,99),-1),ret.z,ret.yaw);setTitle('CENTRAL PLAZA')})}

/* ---- Boot ---- */
const prog=(p,t)=>{$('lbar').style.width=p*100+'%';if(t)$('ltxt').textContent=t};
const ANIMS=['idle','walk','run','jump','wave','headnod'];
async function boot(){try{
 const R={},keys=['character','floor','tree','lamp',...ANIMS.map(a=>'anim_'+a)],crit=['character','floor'];let done=0;prog(.03,'Loading world…');
 await Promise.all(keys.map(async k=>{try{R[k]=await parseGLB(ASSETS[k])}catch(e){if(crit.includes(k))throw e;console.warn('optional asset failed:',k,e)}prog(.05+.85*(++done/keys.length),'Loading '+done+' / '+keys.length)}));
 prog(.93,'Building the city…');city=buildCity(R);cur=city;scene.add(city.group);scene.add(P.root);
 const g=R.character,bb=new THREE.Box3().setFromObject(g.scene),h=bb.max.y-bb.min.y||1,s=C.h/h;g.scene.scale.setScalar(s);g.scene.userData.s=s;
 g.scene.traverse(o=>{if(o.isMesh){o.castShadow=true;o.frustumCulled=false}});P.vis=g.scene;P.root.add(g.scene);P.mixer=new THREE.AnimationMixer(g.scene);
 ANIMS.forEach(a=>{const r=R['anim_'+a];if(r&&r.animations[0])P.acts[a]=P.mixer.clipAction(r.animations[0])});
 if(!P.acts.idle&&g.animations[0])P.acts.idle=P.mixer.clipAction(g.animations[0]);
 fadeTo('idle',.01,false,1);
 const gy=groundAt(city,city.spawn.x,city.spawn.z,99);place(city.spawn.x,gy>-1e8?gy:0,city.spawn.z,city.spawn.yaw);prog(1,'Ready');
 await sleep(250);$('loading').style.opacity=0;setTimeout(()=>$('loading').style.display='none',650);$('hud').classList.add('show');setTitle('CENTRAL PLAZA');
 if(DEBUG)$('dbg').style.display='block';
 const clock=new THREE.Clock();let fc=0;(function loop(){requestAnimationFrame(loop);const dt=Math.min(clock.getDelta(),.05);
  if(In.once.has('KeyT')){TOD.pi=(TOD.pi+1)%TOD.presets.length;TOD.ov=TOD.presets[TOD.pi]}
  updatePlayer(dt);checkInt();updateCam(dt);updateTime(dt);In.once.clear();
  if(DEBUG&&++fc%6===0)$('dbg').textContent=`FPS ${Math.round(1/Math.max(dt,1e-4))}\npos ${P.pos.x.toFixed(1)},${P.pos.y.toFixed(2)},${P.pos.z.toFixed(1)}\ngrounded ${P.grounded}\nstate ${P.state} / clip ${P.curKey}\nworld ${cur.name}\nphase ${TOD.phase}\nclips ${Object.keys(P.acts).join(',')}`;
  renderer.render(scene,camera)})()
}catch(e){console.error(e);showErr('Could not load ANNOVA: '+(e&&e.message||e))}}
$('retry').onclick=()=>location.reload();boot();
})();
</script></body></html>
